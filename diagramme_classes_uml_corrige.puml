@startuml Diagramme de Classes UML - Système de Présence

!theme plain

' ===== ENTITÉS MÉTIER =====

class Utilisateur {
    -id: int
    -nom: String
    -prenom: String
    -email: String
    -motDePasse: String
    -role: Role
    -dateCreation: Date
    -derniereConnexion: Date
    --
    +creerCours(): Cours
    +creerSeance(): Seance
    +marquerPresence(): Presence
    +validerJustification(): void
    +getNomComplet(): String
}

class Etudiant {
    -id: int
    -matricule: String
    -nom: String
    -prenom: String
    -email: String
    -classeId: int
    -dateInscription: Date
    --
    +getNomComplet(): String
    +estInscritAuCours(): boolean
    +getClasse(): ClasseEtablissement
}

class CompteEtudiant {
    -id: int
    -etudiantId: int
    -email: String
    -motDePasse: String
    -dateCreation: Date
    -derniereConnexion: Date
    -actif: boolean
    --
    +authentifier(): boolean
    +changerMotDePasse(): void
    +estActif(): boolean
}

class ClasseEtablissement {
    -id: int
    -code: String
    -nom: String
    -niveau: String
    -filiere: String
    -description: String
    -actif: boolean
    -dateCreation: Date
    --
    +getEtudiants(): Etudiant[]
    +estActive(): boolean
    +getCodeComplet(): String
}

class Cours {
    -id: int
    -code: String
    -nom: String
    -enseignantId: int
    -description: String
    --
    +getEtudiantsInscrits(): Etudiant[]
    +creerSeance(): Seance
    +getEnseignant(): Utilisateur
}

class Inscription {
    -id: int
    -etudiantId: int
    -coursId: int
    -dateInscription: Date
    --
    +validerInscription(): boolean
    +getEtudiant(): Etudiant
    +getCours(): Cours
}

class Seance {
    -id: int
    -nomCours: String
    -enseignantId: int
    -token: String
    -expiration: Date
    -dateCreation: Date
    -active: boolean
    --
    +genererQRCode(): String
    +estValide(): boolean
    +marquerPresence(): Presence
    +getEnseignant(): Utilisateur
}

class Presence {
    -id: int
    -etudiantId: int
    -coursId: int
    -seanceId: int
    -datePresence: Date
    -statut: StatutPresence
    -justification: String
    -justifie: boolean
    -enregistrePar: int
    -dateEnregistrement: Date
    --
    +ajouterJustification(): void
    +validerJustification(): void
    +getEtudiant(): Etudiant
    +getCours(): Cours
    +getSeance(): Seance
}

enum Role {
    ADMIN
    ENSEIGNANT
}

enum StatutPresence {
    PRESENT
    ABSENT
    RETARD
    EXCUSE
}

' ===== MODÈLES FLUTTER =====

class StudentSession {
    -etudiantId: int
    -matricule: String
    -email: String
    -prenom: String
    -nom: String
    -authToken: String
    -serverBaseUrl: String
    -classe: StudentClassInfo
    --
    +getDisplayName(): String
    +fromJson(): StudentSession
    +toJson(): Map
}

class StudentProfile {
    -id: int
    -matricule: String
    -nom: String
    -prenom: String
    -email: String
    -dateInscription: String
    -classe: StudentClassInfo
    --
    +getDisplayName(): String
    +fromJson(): StudentProfile
}

class SeanceInfo {
    -id: int
    -nomCours: String
    -typeSeance: String
    -salleNom: String
    -modeMarquage: String
    -token: String
    -heureDebut: String
    -heureFin: String
    -statutSeance: String
    -studentQrAllowed: boolean
    --
    +isExamMode(): boolean
    +isQrMode(): boolean
    +isManualMode(): boolean
    +isActive(): boolean
    +fromJson(): SeanceInfo
    +toJson(): Map
}

class PresenceRow {
    -presenceId: int
    -datePresence: String
    -statut: String
    -justifie: boolean
    -coursNom: String
    -coursCode: String
    -justifStatut: String
    -justifContenu: String
    -justifDate: String
    -justifCommentaire: String
    --
    +isAbsent(): boolean
    +hasPendingJustification(): boolean
    +canSubmitJustification(): boolean
    +getCoursLabel(): String
    +fromJson(): PresenceRow
}

class StudentClassInfo {
    -id: int
    -code: String
    -nom: String
    -niveau: String
    -filiere: String
    --
    +maybeFromJson(): StudentClassInfo
}

' ===== SERVICES =====

class ApiService {
    -baseUrl: String
    -authToken: String
    --
    +post(): Map
    +get(): Map
    +setAuthToken(): void
}

class AuthService {
    -apiService: ApiService
    --
    +login(): StudentSession
    +logout(): void
    +validateToken(): boolean
}

class SessionStorage {
    --
    +save(): void
    +load(): StudentSession
    +clear(): void
}

' ===== RELATIONS UML AVEC CARDINALITÉS =====

Utilisateur "1" -- "0..*" Cours : enseigner
Utilisateur "1" -- "0..*" Seance : créer
Utilisateur "1" -- "0..*" Presence : enregistrer

ClasseEtablissement "1" -- "0..*" Etudiant : contenir
Etudiant "1" -- "1" CompteEtudiant : posséder
Etudiant "1" -- "0..*" Presence : avoir
Etudiant "0..*" -- "0..*" Cours : s'inscrire

Cours "1" -- "0..*" Seance : générer
Cours "1" -- "0..*" Presence : concerner

Seance "1" -- "0..*" Presence : générer

Inscription "*" -- "1" Etudiant : concerner
Inscription "*" -- "1" Cours : concerner

' ===== RELATIONS FLUTTER =====

StudentSession "1" -- "0..1" StudentClassInfo : contenir
AuthService "1" -- "1" ApiService : dépendre
SessionStorage "1" -- "0..1" StudentSession : stocker

' ===== HÉRITAGE ET DÉPENDANCES =====

Utilisateur ..> Role : utiliser
Presence ..> StatutPresence : utiliser
StudentSession ..> StudentProfile : transformer
SeanceInfo ..> PresenceRow : générer

@enduml
