@startuml Diagramme de Classes UML - Système de Présence

!theme plain

' ===== CLASSES MÉTIER PRINCIPALES =====

class Utilisateur {
    -id: int
    -nom: String
    -prenom: String
    -email: String
    -motDePasse: String
    -role: Role
    -dateCreation: Date
    -derniereConnexion: Date
    --
    +creerCours(): Cours
    +creerSeance(): Seance
    +marquerPresence(): Presence
    +validerJustification(): void
    +getNomComplet(): String
}

class Etudiant {
    -id: int
    -matricule: String
    -nom: String
    -prenom: String
    -email: String
    -classeId: int
    -dateInscription: Date
    --
    +getNomComplet(): String
    +estInscritAuCours(): boolean
    +getClasse(): ClasseEtablissement
}

class ClasseEtablissement {
    -id: int
    -code: String
    -nom: String
    -niveau: String
    -filiere: String
    -description: String
    -actif: boolean
    -dateCreation: Date
    --
    +getEtudiants(): Etudiant[]
    +estActive(): boolean
    +getCodeComplet(): String
}

class Cours {
    -id: int
    -code: String
    -nom: String
    -enseignantId: int
    -description: String
    --
    +getEtudiantsInscrits(): Etudiant[]
    +creerSeance(): Seance
    +getEnseignant(): Utilisateur
}

class Seance {
    -id: int
    -nomCours: String
    -enseignantId: int
    -token: String
    -expiration: Date
    -dateCreation: Date
    -active: boolean
    --
    +genererQRCode(): String
    +estValide(): boolean
    +marquerPresence(): Presence
    +getEnseignant(): Utilisateur
}

class Presence {
    -id: int
    -etudiantId: int
    -coursId: int
    -seanceId: int
    -datePresence: Date
    -statut: StatutPresence
    -justification: String
    -justifie: boolean
    -enregistrePar: int
    -dateEnregistrement: Date
    --
    +ajouterJustification(): void
    +validerJustification(): void
    +getEtudiant(): Etudiant
    +getCours(): Cours
    +getSeance(): Seance
}

class Inscription {
    -id: int
    -etudiantId: int
    -coursId: int
    -dateInscription: Date
    --
    +validerInscription(): boolean
    +getEtudiant(): Etudiant
    +getCours(): Cours
}

class CompteEtudiant {
    -id: int
    -etudiantId: int
    -email: String
    -motDePasse: String
    -dateCreation: Date
    -derniereConnexion: Date
    -actif: boolean
    --
    +authentifier(): boolean
    +changerMotDePasse(): void
    +estActif(): boolean
    +getEtudiant(): Etudiant
}

' ===== ÉNUMÉRATIONS =====

enum Role {
    ADMIN
    ENSEIGNANT
}

enum StatutPresence {
    PRESENT
    ABSENT
    RETARD
    EXCUSE
}

' ===== CLASSES APPLICATION MOBILE (CONNECTÉES) =====

class SessionEtudiant {
    -etudiantId: int
    -matricule: String
    -email: String
    -prenom: String
    -nom: String
    -authToken: String
    -serverBaseUrl: String
    -classe: InfoClasseEtudiant
    --
    +getDisplayName(): String
    +fromJson(): SessionEtudiant
    +toJson(): Map
    +getEtudiant(): Etudiant
}

class InfoClasseEtudiant {
    -id: int
    -code: String
    -nom: String
    -niveau: String
    -filiere: String
    --
    +maybeFromJson(): InfoClasseEtudiant
    +getClasseEtablissement(): ClasseEtablissement
}

class InfoSeance {
    -id: int
    -nomCours: String
    -typeSeance: String
    -nomSalle: String
    -modeMarquage: String
    -token: String
    -heureDebut: String
    -heureFin: String
    -statutSeance: String
    -studentQrAllowed: boolean
    --
    +isExamMode(): boolean
    +isQrMode(): boolean
    +isManualMode(): boolean
    +isActive(): boolean
    +fromJson(): InfoSeance
    +toJson(): Map
    +getSeance(): Seance
}

class LignePresence {
    -presenceId: int
    -datePresence: String
    -statut: String
    -justifie: boolean
    -nomCours: String
    -codeCours: String
    -justifStatut: String
    -justifContenu: String
    -justifDate: String
    -justifCommentaire: String
    --
    +isAbsent(): boolean
    +hasPendingJustification(): boolean
    +canSubmitJustification(): boolean
    +getCoursLabel(): String
    +fromJson(): LignePresence
    +getPresence(): Presence
}

' ===== SERVICES (CONNECTÉS AUX CLASSES MÉTIER) =====

class ServiceApi {
    -baseUrl: String
    -authToken: String
    --
    +post(): Map
    +get(): Map
    +setAuthToken(): void
    +connecterBackend(): boolean
}

class ServiceAuth {
    -apiService: ServiceApi
    --
    +login(): SessionEtudiant
    +logout(): void
    +validateToken(): boolean
    +authentifierEtudiant(): Etudiant
}

class StockageSession {
    --
    +save(): void
    +load(): SessionEtudiant
    +clear(): void
    +getSession(): SessionEtudiant
}

' ===== RELATIONS PRINCIPALES (TOUTES CONNECTÉES) =====

' Relations entre entités métier
Utilisateur "1" -- "0..*" Cours : enseigner
Utilisateur "1" -- "0..*" Seance : créer
Utilisateur "1" -- "0..*" Presence : enregistrer

ClasseEtablissement "1" -- "0..*" Etudiant : contenir
Etudiant "1" -- "1" CompteEtudiant : posséder
Etudiant "1" -- "0..*" Presence : concerner

Cours "1" -- "0..*" Seance : générer
Cours "1" -- "0..*" Presence : concerner

Seance "1" -- "0..*" Presence : générer

' Association many-to-many
Inscription "*" -- "1" Etudiant : concerner
Inscription "*" -- "1" Cours : concerner

' Relations avec les modèles mobiles
SessionEtudiant "1" -- "0..1" InfoClasseEtudiant : contenir
InfoSeance "1" -- "0..1" Seance : représenter
LignePresence "1" -- "0..1" Presence : représenter

InfoClasseEtudiant "1" -- "0..1" ClasseEtablissement : correspondre

' Relations des services avec les classes
ServiceAuth "1" -- "1" ServiceApi : dépendre
ServiceAuth "1" -- "0..1" Etudiant : authentifier
StockageSession "1" -- "0..1" SessionEtudiant : stocker
ServiceApi "1" -- "0..1" Cours : interroger
ServiceApi "1" -- "0..1" Seance : interroger
ServiceApi "1" -- "0..1" Presence : interroger

' Relations des modèles mobiles avec les entités métier
SessionEtudiant "1" -- "0..1" Etudiant : représenter
InfoSeance "1" -- "0..1" Cours : concerner
LignePresence "1" -- "0..1" Cours : concerner

' Dépendances et héritage
Utilisateur ..> Role : utiliser
Presence ..> StatutPresence : utiliser

@enduml
