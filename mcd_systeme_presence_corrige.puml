@startuml MCD Système de Présence - Formalisme UML

!theme plain

' ===== ENTITÉS CONCEPTUELLES =====

entity UTILISATEUR {
    *id_utilisateur
    --
    *nom
    *prenom
    *email
    *mot_de_passe
    *role {admin, enseignant}
    date_creation
    derniere_connexion
}

entity ETUDIANT {
    *id_etudiant
    --
    *matricule
    *nom
    *prenom
    *email
    date_inscription
}

entity PROMOTION {
    *id_promotion
    --
    *code_promotion
    *nom_promotion
    *niveau {L1, L2, L3, M1, M2}
    *filiere
    description
    date_creation
}

entity COURS {
    *id_cours
    --
    *code_cours
    *nom_cours
    description
}

entity SEANCE {
    *id_seance
    --
    *token_qr
    *date_creation
    *heure_debut
    *heure_fin
    *expiration_token
    type_seance {CM, TD, TP, Examen, Contrôle}
    mode_marquage {QR, Manuel, Enseignant seul}
    statut {Planifiée, En cours, Terminée, Annulée}
}

entity PRESENCE {
    *id_presence
    --
    *date_presence
    *statut {Présent, Absent, Retard}
    justification
    justifie {Oui, Non}
    date_enregistrement
}

entity SALLE {
    *id_salle
    --
    *nom_salle
    *batiment
    *capacite
    equipements
    statut {Active, Inactive}
}

entity COMPTET_MOBILE {
    *id_compte
    --
    *email_mobile
    *mot_de_passe_mobile
    date_creation_compte
    derniere_connexion_mobile
    statut_compte {Actif, Inactif}
}

' ===== ASSOCIATIONS CONCEPTUELLES AVEC CARDINALITÉS UML =====

UTILISATEUR "1" -- "0..*" COURS : enseigner
UTILISATEUR "1" -- "0..*" SEANCE : créer
UTILISATEUR "1" -- "0..*" PRESENCE : enregistrer

PROMOTION "1" -- "0..*" ETUDIANT : regrouper
ETUDIANT "1" -- "1" COMPTET_MOBILE : posséder
ETUDIANT "1" -- "0..*" PRESENCE : concerner

COURS "0..*" -- "0..*" ETUDIANT : inscrire
COURS "1" -- "0..*" SEANCE : générer
COURS "1" -- "0..*" PRESENCE : concerner

SEANCE "1" -- "0..*" PRESENCE : générer
SEANCE "0..1" -- "1" SALLE : utiliser

' ===== NOTES EXPLICATIVES =====

note right of UTILISATEUR
  Personnel administratif et enseignant
  Gérer le système et les séances
end note

note right of ETUDIANT
  Population étudiante de l'établissement
  Appartenir à une promotion
end note

note right of PROMOTION
  Structure LMD (Licence-Master-Doctorat)
  Niveau + Filière + Groupe
end note

note right of COURS
  Unité d'enseignement académique
  Matière avec contenu pédagogique
end note

note right of SEANCE
  Session de cours spécifique
  Token QR unique et sécurisé
end note

note right of PRESENCE
  Enregistrement de présence/absence
  Pouvoir être justifiée après coup
end note

note right of SALLE
  Infrastructure physique
  Éviter les conflits d'horaire
end note

note right of COMPTET_MOBILE
  Authentification mobile séparée
  Sécurité renforcée
end note

' ===== CONTRAINTES ET RÈGLES MÉTIER =====

note bottom of ETUDIANT
  CONTRAINTES
  - Un étudiant appartenir à une seule promotion
  - Un étudiant avoir un seul compte mobile
  - Un étudiant pouvoir suivre plusieurs cours
  
  RÈGLES MÉTIER
  - Matricule unique dans l'établissement
  - Email académique unique
end note

note bottom of COURS
  CONTRAINTES
  - Un cours être enseigné par un seul enseignant
  - Un cours pouvoir avoir plusieurs étudiants
  - Un cours générer plusieurs séances
  
  RÈGLES MÉTIER
  - Code cours unique et standardisé
  - Description obligatoire pour la transparence
end note

note bottom of SEANCE
  CONTRAINTES
  - Une séance avoir un token QR unique
  - Une séance se dérouler dans une seule salle
  - Une séance générer plusieurs présences
  
  RÈGLES MÉTIER
  - Token expirer automatiquement
  - Pas de chevauchement dans la même salle
end note

note bottom of PRESENCE
  CONTRAINTES
  - Un étudiant ne pouvoir marquer qu'une fois par séance
  - Une présence pouvoir être justifiée
  - Enregistrement horodaté et traçable
  
  RÈGLES MÉTIER
  - Auto-pointage uniquement en mode QR
  - Modification possible par enseignant
end note

' ===== ASSOCIATIONS SPÉCIFIQUES =====

association INSCRIPTION {
    ETUDIANT "0..*" -- "*" COURS
    --
    *date_inscription
    *statut {Actif, Inactif}
}

note right of INSCRIPTION
  Table d'association many-to-many
  Gérer les inscriptions aux cours
  Suivi temporel des inscriptions
end note

@enduml
