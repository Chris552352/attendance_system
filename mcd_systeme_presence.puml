@startuml MCD Système de Présence Universitaire

!theme plain

' ===== ENTITÉS CONCEPTUELLES =====

entity UTILISATEUR {
    *id_utilisateur
    --
    *nom
    *prenom
    *email
    *mot_de_passe
    *role {admin, enseignant}
    date_creation
    derniere_connexion
}

entity ETUDIANT {
    *id_etudiant
    --
    *matricule
    *nom
    *prenom
    *email
    date_inscription
}

entity PROMOTION {
    *id_promotion
    --
    *code_promotion
    *nom_promotion
    *niveau {L1, L2, L3, M1, M2}
    *filiere
    description
    date_creation
}

entity COURS {
    *id_cours
    --
    *code_cours
    *nom_cours
    description
}

entity SEANCE {
    *id_seance
    --
    *token_qr
    *date_creation
    *heure_debut
    *heure_fin
    *expiration_token
    type_seance {CM, TD, TP, Examen, Contrôle}
    mode_marquage {QR, Manuel, Enseignant seul}
    statut {Planifiée, En cours, Terminée, Annulée}
}

entity PRESENCE {
    *id_presence
    --
    *date_presence
    *statut {Présent, Absent, Retard}
    justification
    justifie {Oui, Non}
    date_enregistrement
}

entity SALLE {
    *id_salle
    --
    *nom_salle
    *batiment
    *capacite
    equipements
    statut {Active, Inactive}
}

entity COMPTET_MOBILE {
    *id_compte
    --
    *email_mobile
    *mot_de_passe_mobile
    date_creation_compte
    derniere_connexion_mobile
    statut_compte {Actif, Inactif}
}

' ===== ASSOCIATIONS CONCEPTUELLES =====

UTILISATEUR ||--o{ COURS : "enseigne"
UTILISATEUR ||--o{ SEANCE : "crée"
UTILISATEUR ||--o{ PRESENCE : "enregistre"

PROMOTION ||--o{ ETUDIANT : "regroupe"
ETUDIANT }|--|| COMPTET_MOBILE : "possède"
ETUDIANT ||--o{ PRESENCE : "concerne"

COURS }o--o{ ETUDIANT : "suit (inscription)"
COURS ||--o{ SEANCE : "génère"
COURS ||--o{ PRESENCE : "concerne"

SEANCE ||--o{ PRESENCE : "génère"
SEANCE }o--|| SALLE : "utilise"

' ===== NOTES EXPLICATIVES =====

note right of UTILISATEUR
  Personnel administratif et enseignant
  Gère le système et les séances
end note

note right of ETUDIANT
  Population étudiante de l'établissement
  Appartient à une promotion
end note

note right of PROMOTION
  Structure LMD (Licence-Master-Doctorat)
  Niveau + Filière + Groupe
end note

note right of COURS
  Unité d'enseignement académique
  Matière avec contenu pédagogique
end note

note right of SEANCE
  Session de cours spécifique
  Token QR unique et sécurisé
end note

note right of PRESENCE
  Enregistrement de présence/absence
  Peut être justifiée après coup
end note

note right of SALLE
  Infrastructure physique
  Évite les conflits d'horaire
end note

note right of COMPTET_MOBILE
  Authentification mobile séparée
  Sécurité renforcée
end note

' ===== CONTRAINTES ET RÈGLES MÉTIER =====

note bottom of ETUDIANT
  - Un étudiant appartient à une seule promotion
  - Un étudiant a un seul compte mobile
  - Un étudiant peut suivre plusieurs cours
end note

note bottom of COURS
  - Un cours est enseigné par un seul enseignant
  - Un cours peut avoir plusieurs étudiants
  - Un cours génère plusieurs séances
end note

note bottom of SEANCE
  - Une séance a un token QR unique
  - Une séance se déroule dans une seule salle
  - Une séance génère plusieurs présences
end note

note bottom of PRESENCE
  - Un étudiant ne peut marquer qu'une fois par séance
  - Une présence peut être justifiée
  - Enregistrement horodaté et traçable
end note

@enduml
